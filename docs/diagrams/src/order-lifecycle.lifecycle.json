  "cards": [
    {
      "dot": "rose",
      "title": "Stock insuficiente",
      "items": [
        "La creación responde 409 con code STOCK_INSUFFICIENT",
        "No existe un estado STOCK_INSUFFICIENT: el pedido se queda en PENDING",
        "No hay rollback ni borrado; el pedido se puede reintentar o cancelar"
      ]
    },
    {
      "dot": "amber",
      "title": "Transiciones inválidas",
      "items": [
        "CANCELLED es terminal: cualquier salida responde 409 INVALID_TRANSITION",
        "No hay transiciones hacia PENDING: el estado inicial se fija al crear el pedido",
        "canTransitionTo es la única fuente de verdad de las transiciones válidas"
      ]
    },
    {
      "dot": "cyan",
      "title": "Historial",
      "items": [
        "Cada transición inserta una fila en order_history con from_status, to_status y trace_id",
        "La creación registra null → PENDING y, si hay stock, PENDING → CONFIRMED",
        "La cancelación registra el estado previo → CANCELLED"
      ]
    }
  ]
