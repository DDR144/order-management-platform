  "cards": [
    {
      "dot": "cyan",
      "title": "Pedidos",
      "items": [
        "orders guarda un solo producto por pedido: no hay tabla de líneas",
        "status se persiste como STRING del enum PENDING, CONFIRMED o CANCELLED",
        "order_history registra cada transición con su from_status, to_status y trace_id"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inventario",
      "items": [
        "products es la única tabla de inventory_db",
        "El stock solo cambia con el UPDATE atómico y condicional del Inventory Service",
        "Los datos semilla se insertan de forma idempotente al arrancar"
      ]
    },
    {
      "dot": "amber",
      "title": "Integridad",
      "items": [
        "El esquema no declara FOREIGN KEY: la integridad la sostiene la aplicación",
        "order_history.order_id referencia orders.order_id sin restricción física",
        "orders.product_id apunta a otra base, así que no puede ser una FK real"
      ]
    }
  ]
