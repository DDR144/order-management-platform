  "cards": [
    {
      "dot": "cyan",
      "title": "Trazabilidad",
      "items": [
        "El gateway reutiliza el X-Trace-Id entrante o genera un UUID v4",
        "Lo propaga a Order e Inventory Service y viaja en la llamada interna",
        "Vuelve en la respuesta y queda en el MDC de cada servicio"
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad",
      "items": [
        "El gateway exige JWT en toda ruta salvo actuator health e info",
        "Order e Inventory Service validan el mismo JWT como resource servers",
        "Keycloak emite los tokens del realm reto-backend"
      ]
    },
    {
      "dot": "emerald",
      "title": "Datos",
      "items": [
        "Cada servicio escribe solo su propia base: order_db e inventory_db",
        "El stock se descuenta con un UPDATE atómico y condicional",
        "El cliente queda fuera de la red interna de docker-compose"
      ]
    }
  ]
